<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        측정에 마이크가 반드시 필요하다. 권한을 요청하는 자리에서 왜 필요한지
        설명한다(명세 18장) — 「소리를 저장하지 않고 음압만 잰다」는 사실이
        사용자에게 먼저 전달돼야 한다.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        예배는 두 시간이고 그동안 담당자는 다른 앱을 본다. 화면이 뒤로 가도
        마이크를 놓지 않으려면 포그라운드 서비스가 필요하다. 형(type)을
        microphone 으로 적어야 안드로이드 14 이상에서 마이크를 계속 쓸 수 있다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
        알림을 띄우려면 13 이상에서 사용자 허락이 필요하다. **거부해도
        측정은 돈다** — 알림이 안 보일 뿐이다. 그래서 측정을 막지 않는다.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        내장 마이크 없는 기기에서도 USB 마이크로 쓸 수 있으므로 required 를
        false 로 둔다. 명세 2장: 내장 마이크는 fallback 이 아니라 정식 입력이고,
        USB 도 마찬가지로 정식 입력이다.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SelahRta">

        <!--
            화면이 돌아가도 액티비티를 다시 만들지 않는다.

            RTA 를 고르면 가로로 눕힌다(사용자 지시). 기본값으로 두면 그때마다
            액티비티가 통째로 새로 만들어지는데, 재는 도중이면 그 사이 소리가
            끊긴다 — 측정 중에는 절대 일어나면 안 되는 일이다. Compose 는
            설정 변경을 스스로 따라가므로 다시 만들 까닭이 없다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.SelahRta">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            화면이 뒤로 가도 측정을 이어 가게 붙들어 두는 서비스.
            밖에서 부를 일이 없으므로 exported 는 false 다.
        -->
        <service
            android:name=".audio.CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
