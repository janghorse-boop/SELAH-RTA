#
# 켜는 방법(복제한 뒤 한 번): git config core.hooksPath .githooks
# 급할 때 건너뛰기: git push --no-verify  (무엇을 건너뛰는지 알고 쓸 것)

node scripts/check-branch-open.mjs || exit 1
