{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToneVista Galaxy Microphone Location DB",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "checked_on",
    "models",
    "pending_models",
    "sources",
    "runtime_policy",
    "orientation_conventions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "content_version": {
      "type": "string"
    },
    "checked_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "pending_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "status",
          "automatic_lookup_enabled"
        ],
        "properties": {
          "automatic_lookup_enabled": {
            "const": false
          },
          "documented_mic_location_count": {
            "type": "null"
          },
          "locations": {
            "type": "null"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "author",
          "title",
          "url",
          "hosting"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "hosting": {
            "enum": [
              "official",
              "external_mirror"
            ]
          }
        }
      }
    },
    "runtime_policy": {
      "type": "object"
    },
    "orientation_conventions": {
      "type": "object"
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "location_key",
        "surface",
        "description_ko",
        "evidence",
        "android_microphone_id"
      ],
      "properties": {
        "location_key": {
          "type": "string"
        },
        "surface": {
          "enum": [
            "top_edge",
            "bottom_edge",
            "left_edge",
            "right_edge",
            "rear",
            "rear_camera_rim",
            "rear_camera_area"
          ]
        },
        "description_ko": {
          "type": "string"
        },
        "android_microphone_id": {
          "type": "null"
        },
        "normalized_diagram_coordinates": {
          "type": "null"
        },
        "evidence": {
          "type": "object",
          "required": [
            "source_id",
            "printed_page",
            "pdf_page_index"
          ],
          "properties": {
            "source_id": {
              "type": "string"
            },
            "printed_page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pdf_page_index": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "model_id",
        "marketing_name",
        "category",
        "documented_model_codes",
        "documented_mic_location_count",
        "physical_microphone_capsule_count",
        "locations",
        "orientation_id",
        "source_ids",
        "default_spl_offset_db"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "phone",
            "tablet"
          ]
        },
        "documented_model_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "documented_mic_location_count": {
          "type": "integer",
          "minimum": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "verification_status": {
          "enum": [
            "service_diagram_verified",
            "manual_diagram_verified"
          ]
        },
        "release_use_status": {
          "const": "documentary_reference_not_device_tested"
        },
        "physical_microphone_capsule_count": {
          "type": "null"
        },
        "default_spl_offset_db": {
          "type": "null"
        },
        "independent_microphone_selection_supported": {
          "type": "null"
        },
        "active_android_microphone_ids": {
          "type": "null"
        },
        "physical_to_android_mapping": {
          "type": "null"
        }
      }
    }
  }
}