+// AGP 8.13.0: select release variants, then only their final packaging/signing tasks.
+// This covers flavor names, but AGP task-name changes still need graph regression tests.
+androidComponents {
+    onVariants(selector().withBuildType("release")) { variant ->
+        val suffix = variant.name.replaceFirstChar { it.uppercaseChar() }
+        val guardedTasks = setOf(
+            "bundle$suffix", "assemble$suffix", "package$suffix",
+            "package${suffix}Bundle", "package${suffix}UniversalApk",
+            "sign${suffix}Bundle", "validateSigning$suffix",
+            "signingConfigWriter$suffix",
+        )
+        tasks.matching { it.name in guardedTasks }
+            .configureEach { dependsOn(verifyReleaseSigning) }
+    }
+}
